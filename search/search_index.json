{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":["stopWordFilter"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"Home","text":""},{"location":"#_1","title":"\u7279\u79cd\u7eb8\u5370\u5237\u6848\u4f8b\uff1a\u6807\u51c6\u5316\u201c\u79bb\u5a5a\u8bc1\u201d\u5236\u4f5c\u5de5\u827a\u6d41\u7a0b\u4e0e\u8bbe\u8ba1\u7ec6\u8282\u5c55\u793a","text":"<p>\u5728\u73b0\u4ee3\u5305\u88c5\u8bbe\u8ba1\u4e0e\u9ad8\u7aef\u9632\u4f2a\u5370\u5237\u9886\u57df\uff0c\u56fd\u5bb6\u6cd5\u5b9a\u6587\u4e66\u56e0\u5176\u4e0d\u53ef\u66ff\u4ee3\u7684\u6743\u5a01\u6027\u3001\u6781\u9ad8\u7684\u9632\u4f2a\u95e8\u69db\u4ee5\u53ca\u957f\u671f\u4fdd\u5b58\u7684\u786c\u6027\u9700\u6c42\uff0c\u4e00\u76f4\u88ab\u89c6\u4e3a\u884c\u4e1a\u6280\u672f\u5de5\u827a\u7684\u201c\u5929\u82b1\u677f\u201d\u3002\u5176\u4e2d\uff0c\u201c\u79bb\u5a5a\u8bc1\u201d\u5236\u4f5c\u4e0e\u8bbe\u8ba1\u5de5\u827a\u7531\u4e8e\u878d\u5408\u4e86\u9ad8\u514b\u91cd\u7279\u79cd\u5145\u76ae\u7eb8\u3001\u7cbe\u5bc6\u70eb\u94f6\u3001\u5b9a\u5411\u5b89\u5168\u9632\u4f2a\u6c34\u5370\u5e01\u7eb8\u7b49\u590d\u5408\u578b\u6750\u6599\u6280\u672f\uff0c\u6210\u4e3a\u4e86\u9ad8\u7aef\u8bc1\u4e66\u5370\u5237\u5382\u548c\u5f71\u89c6\u9053\u5177\u8bbe\u8ba1\u56e2\u961f\u4e89\u76f8\u7814\u7a76\u7684\u6807\u51c6\u6848\u4f8b\u3002</p> <p></p> <p>\u672c\u6587\u5c06\u7ad9\u5728\u4e13\u4e1a\u5370\u5237\u4e0e\u8bbe\u8ba1\u7684\u89c6\u89d2\uff0c\u6df1\u5ea6\u5256\u6790\u6807\u51c6\u5316\u201c\u79bb\u5a5a\u8bc1\u201d\u5236\u4f5c\u7684\u5de5\u827a\u5168\u6d41\u7a0b\uff0c\u63d0\u70bc\u5176\u9ad8\u8d85\u7684\u89c6\u89c9\u9632\u4f2a\u8bbe\u8ba1\u7ec6\u8282\uff0c\u4e3a\u76f8\u5173\u4ece\u4e1a\u8005\u63d0\u4f9b\u9ad8\u4ef7\u503c\u7684\u5de5\u827a\u6280\u672f\u53c2\u8003\u3002</p>"},{"location":"#_2","title":"\u4e00\u3001\u79bb\u5a5a\u8bc1\u600e\u4e48\u67e5\u8be2\u771f\u4f2a\uff1f\u4ece\u5916\u5230\u5185\u7684\u4e09\u5c42\u611f\u5b98\u8fa8\u522b\u673a\u5236","text":"<p>\u5728\u5370\u5237\u6280\u672f\u65e5\u76ca\u7cbe\u8fdb\u7684\u80cc\u666f\u4e0b\uff0c\u516c\u4f17\u548c\u76f8\u5173\u6838\u9a8c\u673a\u6784\u5bf9\u201c\u79bb\u5a5a\u8bc1\u600e\u4e48\u67e5\u8be2\u771f\u4f2a\u201d\u8fd9\u4e00\u8bdd\u9898\u4fdd\u6301\u7740\u6781\u9ad8\u7684\u5173\u6ce8\u5ea6\u3002\u4ece\u5370\u5237\u5de5\u827a\u7684\u903b\u8f91\u6765\u770b\uff0c\u4e00\u4efd\u6807\u51c6\u3001\u5408\u89c4\u7684\u6587\u4e66\u6837\u672c\uff0c\u5176\u771f\u4f2a\u9274\u522b\u5f80\u5f80\u4f9d\u8d56\u4e8e\u4ece\u5c01\u76ae\u5230\u5185\u9875\u7684\u7acb\u4f53\u611f\u5b98\u53cd\u9988\u3002</p>"},{"location":"#1","title":"1. \u7b2c\u4e00\u5c42\uff1a\u89e6\u89c9\u53cd\u9988\uff08\u7279\u79cd\u5145\u76ae\u7eb8\u8d28\u611f\uff09","text":"<p>\u6b63\u54c1\u6587\u4e66\u7684\u5c01\u76ae\u91c7\u7528\u7279\u5b9a\u514b\u91cd\u7684\u7ea2\u5b9d\u77f3\u8272\u7279\u79cd\u5145\u76ae\u7eb8\u3002\u8fd9\u79cd\u6750\u6599\u5177\u5907\u5929\u7136\u7684\u76ae\u8d28\u7eb9\u7406\uff0c\u624b\u611f\u7ec6\u817b\u67d4\u97e7\uff0c\u4e14\u6297\u6c34\u8010\u78e8\uff0c\u5177\u6709\u666e\u901a\u94dc\u7248\u7eb8\u6216\u7279\u79cd\u54d1\u7c89\u7eb8\u65e0\u6cd5\u6bd4\u62df\u7684\u575a\u633a\u5ea6\u3002</p>"},{"location":"#2","title":"2. \u7b2c\u4e8c\u5c42\uff1a\u89c6\u89c9\u9632\u4f2a\uff08\u591a\u91cd\u4e13\u8272\u4e0e\u9690\u85cf\u6c34\u5370\uff09","text":"<p>\u5728\u5e38\u6001\u5149\u7ebf\uff08\u767d\u5149\uff09\u4e0b\uff0c\u5185\u9875\u5448\u73b0\u7279\u6709\u7684\u591a\u8272\u63a5\u7ebf\u6216\u5f69\u8679\u6e10\u53d8\u5e95\u7eb9\u3002\u800c\u5f53\u6301\u6709\u8005\u5f00\u542f\u624b\u673a\u624b\u7535\u7b52\u7b49\u5149\u6e90\uff0c\u5bf9\u7740\u5149\u7ebf\u8f7b\u8f7b\u4e00\u6643\u65f6\uff0c\u5185\u9875\u7eb8\u5f20\u6df1\u5904\u4f1a\u900f\u51fa\u6e05\u6670\u3001\u7acb\u4f53\u7684\u201c\u53cc\u559c\u201d\u5b57\u5b9a\u5411\u5b9a\u4f4d\u5b89\u5168\u9632\u4f2a\u6c34\u5370\u3002\u8fd9\u5e76\u975e\u6d6a\u6f2b\u4e3b\u4e49\u8bbe\u8ba1\uff0c\u800c\u662f\u76ee\u524d\u9632\u4f2a\u6027\u80fd\u6781\u5f3a\u7684\u4e13\u7528\u5370\u949e\u7eb8\u6750\u6599\u6280\u672f\u3002</p>"},{"location":"#3","title":"3. \u7b2c\u4e09\u5c42\uff1a\u7ea2\u5916\u4e0e\u7d2b\u5916\u5149\u5316\u5b66\u53cd\u5e94","text":"<p>\u5728\u4e13\u4e1a\u6838\u9a8c\u573a\u666f\u4e0b\uff0c\u5c06\u8bc1\u4e66\u7f6e\u4e8e\u7d2b\u5916\u7ebf\u706f\uff08UV\u706f\uff09\u4e0b\u7167\u5c04\uff0c\u5c01\u76ae\u4e0a\u4f1a\u7acb\u523b\u663e\u73b0\u51fa\u539f\u672c\u8089\u773c\u4e0d\u53ef\u89c1\u7684\u65e0\u8272\u8367\u5149\u201c\u4e2d\u534e\u4eba\u6c11\u5171\u548c\u56fd\u5a5a\u59fb\u8bc1\u4e66\u201d\u5b57\u6837\u53ca\u82f1\u6587\u7b80\u79f0\u3002\u540c\u65f6\uff0c\u5185\u9875\u7684\u6d41\u6c34\u53f7\u91c7\u7528\u7ea2\u8272\u8367\u5149\u9632\u4f2a\u6cb9\u58a8\u5370\u5236\uff0c\u5176\u5728\u7279\u5b9a\u6ce2\u957f\u4e0b\u7684\u53d1\u5149\u9971\u548c\u5ea6\u6709\u7740\u6781\u4e3a\u4e25\u683c\u7684\u6280\u672f\u6807\u51c6\u3002</p>"},{"location":"#_3","title":"\u4e8c\u3001\u6807\u51c6\u5316\u201c\u79bb\u5a5a\u8bc1\u201d\u5236\u4f5c\u5de5\u827a\u6d41\u7a0b\u5927\u63ed\u79d8\uff1a\u9ad8\u7aef\u8bc1\u4e66\u5370\u5237\u7684\u56db\u9053\u5927\u5173","text":"<p>\u8981\u5b8c\u7f8e\u8fd8\u539f\u6216\u8005\u8bbe\u8ba1\u4e00\u4efd\u8fbe\u5230\u9ad8\u6807\u51c6\u8981\u6c42\u7684\u6cd5\u5b9a\u8bc1\u4e66\uff0c\u5fc5\u987b\u7ecf\u8fc7\u591a\u9053\u590d\u6742\u7684\u5370\u5237\u4e0e\u5370\u540e\u52a0\u5de5\u5de5\u5e8f\u3002\u4ee5\u4e0b\u662f\u8bc1\u4e66\u5370\u5237\u5382\u8fdb\u884c\u6807\u51c6\u5316\u201c\u79bb\u5a5a\u8bc1\u201d\u5236\u4f5c\u65f6\u7684\u6838\u5fc3\u5de5\u827a\u6d41\u7a0b\uff1a</p> \u5de5\u5e8f\u8282\u70b9 \u6838\u5fc3\u64cd\u4f5c\u4e0e\u6750\u6599\u9009\u62e9 \u6280\u672f\u5de5\u827a\u8981\u70b9 1. \u5c01\u9762\u5907\u6599 \u9009\u7528\u8fdb\u53e3\u7ea2\u5b9d\u77f312\u7cfb\u5217210\u514b\u7279\u79cd\u5145\u76ae\u7eb8 \u4e25\u683c\u63a7\u5236\u4e0d\u540c\u6279\u6b21\u7684\u7eb8\u5f20\u8272\u5dee\u4e0e\u7eb9\u7406\u5bc6\u5ea6 2. \u7cbe\u5bc6\u70eb\u94f6 \u56fd\u5fbd\u3001\u6807\u9898\u53ca\u6846\u7ebf\u91c7\u7528\u9ad8\u7cbe\u5ea6\u7535\u5316\u94dd\u70eb\u5370 \u4e0e\u7ed3\u5a5a\u8bc1\u7684\u201c\u70eb\u91d1\u201d\u533a\u9694\uff0c\u79bb\u5a5a\u8bc1\u5fc5\u987b\u505a\u5230\u8fb9\u7f18\u5e73\u6574\u3001\u91d1\u5c5e\u5149\u6cfd\u5ea6\u9ad8\u4e14\u4e0d\u6613\u8131\u843d 3. \u8bc1\u82af\u5370\u5237 100\u514b\u5b9a\u5411\u5b9a\u4f4d\u9632\u4f2a\u6c34\u5370\u5e01\u7eb8+\u5b9a\u505a\u4e13\u8272\u6cb9\u58a8 \u91c7\u7528\u5168\u9875\u624b\u7ed8\u9632\u4f2a\u7248\u753b\u53ca\u6d6e\u96d5\u5e95\u7eb9\u8fdb\u884c\u591a\u8272\u63a5\u7ebf\u5370\u5237 4. \u540e\u9053\u52a0\u5de5 \u6d41\u6c34\u53f7\u8367\u5149\u55b7\u7801\u3001\u94a2\u5370\u538b\u5236\u3001\u88c1\u5207\u4e0e\u88c5\u8ba2 \u6536\u7eb8\u4fa7\u6321\u7eb8\u677f\u9700\u677e\u7d27\u9002\u5ea6\uff0c\u9632\u6b62\u7279\u79cd\u7eb8\u80cc\u9762\u7c98\u810f"},{"location":"#_4","title":"\u5de5\u827a\u96be\u70b9\u63d0\u793a\uff1a","text":"<p>\u7279\u79cd\u7eb8\u5728\u5b8c\u6210\u5e95\u7eb9\u5370\u5237\u540e\uff0c\u901a\u5e38\u9700\u8981\u7ecf\u8fc7\u70eb\u5370\u3001\u538b\u75d5\u3001\u8986\u819c\u7b49\u591a\u9053\u5370\u540e\u5de5\u5e8f\u3002\u7531\u4e8e\u5145\u76ae\u7eb8\u4e0e\u9632\u4f2a\u6c34\u5370\u7eb8\u7684\u5438\u58a8\u6027\u4e0e\u666e\u901a\u827a\u672f\u7eb8\u5b58\u5728\u5dee\u5f02\uff0c\u5728\u5370\u5237\u65f6\u5fc5\u987b\u6839\u636e\u7ecf\u9a8c\u4e25\u683c\u63a7\u5236\u55b7\u7c89\u91cf\uff0c\u4f7f\u5176\u5c3d\u53ef\u80fd\u5c0f\uff0c\u4ee5\u5229\u4e8e\u540e\u7eed\u70eb\u94f6\u4e0e\u94a2\u5370\u5de5\u5e8f\u7684\u5b8c\u7f8e\u9644\u7740\uff0c\u907f\u514d\u5de5\u827a\u5931\u6548\u3002</p>"},{"location":"#_5","title":"\u4e09\u3001\u4e2d\u5f0f\u79bb\u5a5a\u7f8e\u5b66\u80cc\u540e\u7684\u8bbe\u8ba1\u7ec6\u8282\uff1a\u56fd\u82b1\u7261\u4e39\u3001\u7248\u753b\u6d6e\u96d5\u4e0e\u9690\u85cf\u7684\u6c34\u5370\u827a\u672f","text":"<p>\u73b0\u884c\u6807\u51c6\u7684\u5a5a\u59fb\u767b\u8bb0\u8bc1\u4ef6\u5728\u8bc1\u82af\u8bbe\u8ba1\u4e0a\uff0c\u90fd\u7ecf\u5386\u4e86\u4ece\u201c\u4f20\u7edf\u504f\u5411\u201d\u5230\u201c\u73b0\u4ee3\u6807\u51c6\u5316\u201d\u7684\u6f14\u53d8\u3002\u65e0\u8bba\u662f\u7ed3\u5a5a\u8bc1\u8fd8\u662f\u79bb\u5a5a\u8bc1\uff0c\u5176\u8bc1\u82af\u5747\u6452\u5f03\u4e86\u591a\u4f59\u7684\u4fee\u9970\uff0c\u7edf\u4e00\u91c7\u7528\u56fd\u82b1\u7261\u4e39\u4f5c\u4e3a\u4e3b\u8981\u8bbe\u8ba1\u5143\u7d20\uff0c\u5176\u7cbe\u7ec6\u7a0b\u5ea6\u582a\u79f0\u827a\u672f\u54c1\u3002</p>"},{"location":"#1_1","title":"1. \u624b\u7ed8\u9632\u4f2a\u7248\u753b\u4e0e\u6d6e\u96d5\u5e95\u7eb9","text":"<p>\u5728\u5185\u9875\u8bbe\u8ba1\u4e2d\uff0c\u6240\u6709\u7684\u7261\u4e39\u82b1\u5349\u4e0e\u7f51\u7ebf\u5e76\u975e\u7531\u666e\u901a\u7684\u6392\u7248\u8f6f\u4ef6\u76f4\u63a5\u751f\u6210\uff0c\u800c\u662f\u901a\u8fc7\u9ad8\u7cbe\u5ea6\u7684\u624b\u7ed8\u9632\u4f2a\u7248\u753b\u6280\u672f\u7ed8\u5236\uff0c\u518d\u8f6c\u5316\u4e3a\u6d6e\u96d5\u5e95\u7eb9\u8fdb\u884c\u5168\u9875\u5168\u8986\u76d6\u3002\u8fd9\u79cd\u7ebf\u6761\u5177\u6709\u6781\u5f3a\u7684\u7acb\u4f53\u9519\u89c9\uff0c\u666e\u901a\u590d\u5370\u673a\u6216\u8005\u626b\u63cf\u4eea\u5728\u6355\u6349\u6b64\u7c7b\u9ad8\u9891\u6e10\u53d8\u7ec6\u8282\u65f6\u5bb9\u6613\u4ea7\u751f\u4e25\u91cd\u5931\u771f\u3002</p>"},{"location":"#2_1","title":"2. \u201c\u53cd\u5dee\u611f\u201d\u7684\u6c34\u5370\u9632\u4f2a\uff1a\u80cc\u9762\u5370\u56cd\u5b57","text":"<p>\u5728\u8fd1\u5e74\u5f15\u53d1\u5168\u7f51\u70ed\u8bae\u7684\u201c\u79bb\u5a5a\u8bc1\u80cc\u9762\u5370\u56cd\u5b57\u201d\u73b0\u8c61\uff0c\u672c\u8d28\u4e0a\u662f\u5370\u5237\u6750\u6599\u79d1\u5b66\u7684\u786c\u6838\u4f53\u73b0\u3002\u4ece\u5de5\u827a\u89d2\u5ea6\u89e3\u91ca\uff0c\u7531\u4e8e\u7ed3\u5a5a\u8bc1\u4e0e\u79bb\u5a5a\u8bc1\u5728\u751f\u4ea7\u65f6\u7edf\u4e00\u91c7\u7528\u7684\u662f\u4e13\u4e1a\u5370\u949e\u7eb8\u5382\u5b9a\u505a\u7684\u6bcf\u5e73\u65b9\u7c73100\u514b\u201c\u559c\u559c\u201d\u5b57\u5b89\u5168\u9632\u4f2a\u6c34\u5370\u7eb8\uff0c\u8fd9\u79cd\u7eb8\u5f20\u5728\u51fa\u5382\u65f6\u6c34\u5370\u5c31\u5df2\u7ecf\u56fa\u5316\u5728\u7eb8\u5f20\u7ea4\u7ef4\u5185\u90e8\u3002\u8fd9\u79cd\u201c\u80cc\u9762\u85cf\u56cd\u201d\u7684\u6280\u672f\uff0c\u4e0d\u4ec5\u6781\u813f\u5730\u63d0\u9ad8\u4e86\u9020\u5047\u95e8\u69db\uff0c\u66f4\u5728\u4e0d\u7ecf\u610f\u95f4\u8d4b\u4e88\u4e86\u6587\u4e66\u4e00\u79cd\u201c\u544a\u522b\u8fc7\u53bb\u3001\u91cd\u83b7\u65b0\u751f\u201d\u7684\u6e29\u548c\u4eea\u5f0f\u611f\u3002</p>"},{"location":"#_6","title":"\u56db\u3001\u7279\u79cd\u7eb8\u6848\u4f8b\u603b\u7ed3\uff1a\u8bbe\u8ba1\u5e08\u4e0e\u5f71\u89c6\u9053\u5177\u56e2\u961f\u7684\u5408\u89c4\u843d\u5730\u6307\u5357","text":"<p>\u65e0\u8bba\u662f\u4e3a\u4e86\u5c55\u73b0\u4e2a\u4eba\u6392\u7248\u89c6\u89c9\u7684\u8bbe\u8ba1\u5e08\uff0c\u8fd8\u662f\u81f4\u529b\u4e8e\u8fd8\u539f\u771f\u5b9e\u5386\u53f2\u573a\u666f\u7684\u5f71\u89c6\u5267\u52a1\u56e2\u961f\uff0c\u5728\u6d89\u8db3\u8fd9\u7c7b\u9ad8\u89c4\u683c\u8bc1\u4e66\u7684\u6a21\u62df\u5236\u4f5c\u65f6\uff0c\u5fc5\u987b\u5c06\u6280\u672f\u5408\u89c4\u4e0e\u6750\u6599\u89c4\u8303\u653e\u5728\u7b2c\u4e00\u4f4d\u3002</p> <ul> <li>\u514b\u91cd\u4e0e\u633a\u5ea6\u628a\u63e1\uff1a \u5236\u4f5c\u6b64\u7c7b\u9ad8\u6863\u8bc1\u4e66\u65f6\uff0c\u5185\u9875\u5e94\u4e25\u683c\u9650\u5b9a\u5728100g\u5de6\u53f3\u7684\u9632\u4f2a\u827a\u672f\u7eb8\uff0c\u800c\u5c01\u76ae\u7ed3\u5408\u5145\u76ae\u7eb8\u7684\u7279\u6027\u5e94\u5728200g-250g\u4e4b\u95f4\uff0c\u4f4e\u4e8e\u6b64\u514b\u91cd\u5219\u7f3a\u4e4f\u8d28\u611f\uff0c\u9ad8\u4e8e350g\u5219\u5bb9\u6613\u5bfc\u81f4\u6298\u9875\u5904\u5f00\u88c2\u6216\u53d7\u9650\u4e8e\u8fdb\u7eb8\u901a\u9053\u3002</li> <li>\u4e13\u8272\u8c03\u914d\u800c\u975e\u56db\u8272\u6df7\u5370\uff1a \u6709\u8272\u7279\u79cd\u7eb8\u548c\u9632\u4f2a\u5185\u9875\u8868\u9762\u7edd\u5bf9\u4e0d\u80fd\u76f4\u63a5\u5370CMYK\u56db\u8272\u56fe\u50cf\uff0c\u5426\u5219\u4f1a\u5bfc\u81f4\u4e25\u91cd\u7684\u504f\u8272\u6216\u6d6e\u58a8\u73b0\u8c61\u3002\u5fc5\u987b\u4f7f\u7528\u91d1\u3001\u94f6\u6216\u4e13\u95e8\u8c03\u914d\u7684\u4e13\u8272\u6cb9\u58a8\u8fdb\u884c\u5355\u8272\u6216\u591a\u8272\u53e0\u5370\uff0c\u624d\u80fd\u51f8\u663e\u51fa\u8bc1\u4e66\u7684\u5e84\u91cd\u611f\u4e0e\u5de5\u4e1a\u7f8e\u611f\u3002</li> </ul> <p>\u7248\u6743\u4e0e\u5408\u89c4\u58f0\u660e\uff1a \u672c\u5370\u5237\u6848\u4f8b\u53ca\u5de5\u827a\u6d41\u7a0b\u89e3\u6790\u4ec5\u4f9b\u7279\u79cd\u7eb8\u5370\u5237\u884c\u4e1a\u6280\u672f\u4ea4\u6d41\u3001\u827a\u672f\u6392\u7248\u8bbe\u8ba1\u5c55\u793a\u53ca\u5f71\u89c6\u5267\u9053\u5177\u5236\u4f5c\u53c2\u8003\uff0c\u4e25\u7981\u4efb\u4f55\u7ec4\u7ec7\u6216\u4e2a\u4eba\u5229\u7528\u76f8\u5173\u5de5\u827a\u6280\u672f\u4ece\u4e8b\u975e\u6cd5\u4f2a\u9020\u3001\u53d8\u9020\u56fd\u5bb6\u673a\u5173\u8bc1\u4ef6\u7684\u884c\u4e3a\u3002</p>"}]}